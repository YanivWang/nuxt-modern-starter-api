# 文件职责：生产环境变量模板。
# 复制为 .env.production 后必须替换所有 replace_with/change_me 类占位值，否则 src/env.ts 会拒绝启动。
APP_ENV=production
NODE_ENV=production
JWT_SECRET=replace_with_random_string_at_least_32_characters_long
PORT=3000
GATEWAY_HOST_PORT=2026
LOG_LEVEL=info
LOG_TO_FILE=false
CORS_ORIGINS=https://app.example.com
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=true

AUTH_TOKEN_BLACKLIST_ENABLED=true
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@127.0.0.1:6379

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nuxt_modern_starter_api
DB_USER=app_user
DB_PWD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# 可选：Docker 构建时使用私有或区域 npm registry，例如 https://registry.npmmirror.com
NPM_REGISTRY=
