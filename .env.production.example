APP_ENV=production
NODE_ENV=production
JWT_SECRET=replace_with_random_string_at_least_32_characters_long
PORT=3000
GATEWAY_HOST_PORT=2026
LOG_LEVEL=info
LOG_TO_FILE=false
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1

REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@127.0.0.1:6379

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=express_modern_starter
DB_USER=app_user
DB_PWD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# 可选：Docker 构建时使用私有或区域 npm registry，例如 https://registry.npmmirror.com
NPM_REGISTRY=
