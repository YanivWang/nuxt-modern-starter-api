# 文件职责：生产环境变量模板。
# 复制为 .env.production 后必须替换所有 replace_with/change_me 类占位值，否则 src/env.ts 会拒绝启动。
APP_ENV=production
NODE_ENV=production
JWT_SECRET=replace_with_random_string_at_least_32_characters_long
PORT=3000
GATEWAY_HOST_PORT=2027
LOG_LEVEL=info
LOG_TO_FILE=false
CORS_ORIGINS=https://app.example.com
NUXT_REVALIDATE_URL=https://app.example.com/api/revalidate
REVALIDATE_SECRET=replace_with_random_revalidate_secret
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=true

AUTH_TOKEN_BLACKLIST_ENABLED=true
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@127.0.0.1:6379

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nuxt_modern_starter_api
DB_USER=app_user
DB_PWD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# 可选：Docker 构建时使用私有或区域 npm registry，例如 https://registry.npmmirror.com
NPM_REGISTRY=

# --- 认证强度 ---
# bcrypt 代价因子（10～15）。提高会线性增加登录 CPU 开销。
BCRYPT_ROUNDS=12
# 连续登录失败达到该次数后临时锁定账号（需要 Redis；无 Redis 时不锁定）。
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# --- 后台清理 ---
# 过期/已撤销的 refresh token 会话行保留天数。
REFRESH_TOKEN_RETENTION_DAYS=7
# 大文件上传临时分片的保留小时数。
UPLOAD_TEMP_RETENTION_HOURS=24
# 清理任务执行间隔（毫秒），默认 6 小时。
CLEANUP_INTERVAL_MS=21600000
