{
  "name": "nuxt-modern-starter-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec tsx src/server.ts",
    "dev:debug": "cross-env NODE_ENV=development nodemon --inspect=0.0.0.0:9229 --exec tsx src/server.ts",
    "check": "pnpm run architecture:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run openapi:check && pnpm run test && pnpm run build",
    "test": "pnpm run test:coverage && pnpm run test:integration && pnpm run test:env",
    "test:unit": "cross-env APP_ENV=test NODE_ENV=test vitest run",
    "test:coverage": "cross-env APP_ENV=test NODE_ENV=test vitest run --coverage",
    "test:integration": "cross-env APP_ENV=test NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "test:env": "cross-env APP_ENV=test NODE_ENV=test node --import tsx scripts/test-env.ts",
    "architecture:check": "node scripts/validate-architecture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node --import tsx src/migrate.ts up",
    "db:migrate:undo": "node --import tsx src/migrate.ts down",
    "db:migrate:pending": "node --import tsx src/migrate.ts pending",
    "db:migrate:executed": "node --import tsx src/migrate.ts executed",
    "db:migrate:prod": "node dist/migrate.js up",
    "db:drop-create": "node --import tsx scripts/reset-db.ts",
    "docker:dev": "cross-env APP_ENV=development docker compose --env-file .env.development -f docker/docker-compose.base.yaml -f docker/docker-compose.dev.yaml up -d --build",
    "docker:dev:down": "cross-env APP_ENV=development docker compose --env-file .env.development -f docker/docker-compose.base.yaml -f docker/docker-compose.dev.yaml down",
    "docker:prod": "cross-env APP_ENV=production docker compose --env-file .env.production -f docker/docker-compose.base.yaml -f docker/docker-compose.yaml up -d --build",
    "docker:prod:down": "cross-env APP_ENV=production docker compose --env-file .env.production -f docker/docker-compose.base.yaml -f docker/docker-compose.yaml down"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "4.22.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.12.1",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.62.1",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=10.17.0"
  }
}
