# 文件职责：测试环境变量。
# 供 pnpm test 使用，DB_NAME 必须包含 test，否则集成测试会拒绝运行。
APP_ENV=test
NODE_ENV=test
JWT_SECRET=test_jwt_secret_replace_with_32_chars
PORT=3000
LOG_LEVEL=error
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_BLACKLIST_ENABLED=true
# 测试环境使用允许范围内最低的 bcrypt 代价：哈希强度不是集成测试要验证的东西，
# 而按生产代价运行会让每次登录多花数百毫秒，把断言压到超时。
BCRYPT_ROUNDS=10
REDIS_PASSWORD=dev_redis_password_change_me
REDIS_URL=redis://:dev_redis_password_change_me@127.0.0.1:6379
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nuxt_modern_starter_api_test
DB_USER=app_user
DB_PWD=app_password_123456
MYSQL_ROOT_PASSWORD=root_password_change_me
NUXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=test_revalidate_secret_replace_with_random
