# 文件职责：开发环境变量模板。
# 复制为 .env.development 后按本机 MySQL/Redis 与前端域名调整；生产环境请使用 .env.production.example。
APP_ENV=development
NODE_ENV=development
JWT_SECRET=replace_with_random_string_at_least_32_characters_long
PORT=3000
GATEWAY_HOST_PORT=2027
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
NUXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev_revalidate_secret_replace_with_random_string
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_BLACKLIST_ENABLED=true
REDIS_PASSWORD=dev_redis_password_change_me
REDIS_URL=redis://:dev_redis_password_change_me@127.0.0.1:6379
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nuxt_modern_starter_api
DB_USER=app_user
DB_PWD=app_password_123456
MYSQL_ROOT_PASSWORD=root_password_change_me

# --- 认证强度 ---
# bcrypt 代价因子（10～15）。提高会线性增加登录 CPU 开销。
BCRYPT_ROUNDS=12
# 连续登录失败达到该次数后临时锁定账号（需要 Redis；无 Redis 时不锁定）。
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# --- 后台清理 ---
# 过期/已撤销的 refresh token 会话行保留天数。
REFRESH_TOKEN_RETENTION_DAYS=7
# 大文件上传临时分片的保留小时数。
UPLOAD_TEMP_RETENTION_HOURS=24
# 清理任务执行间隔（毫秒），默认 6 小时。
CLEANUP_INTERVAL_MS=21600000
